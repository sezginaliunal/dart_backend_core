DB_DB_NAME=base_backend
DB_CONNECT_TIMEOUT_SECONDS=10
DB_MAX_RETRIES=3
DB_RETRY_DELAY_SECONDS=2

# En az 32 karakter. Uret: openssl rand -base64 48
JWT_SECRET=N[,,c9&6Q6+<t95}%abO[K+/1bmZyLrBIp2\7t4TW£vg*_Blh<
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60

JWT_ISSUER=base_backend_api
